{
  "manifest_version": 3,
  "name": "knobs: Dark Mode, Responsive and Accessibility Tester for Developers",
  "short_name": "knobs",
  "version": "0.6.6",
  "description": "Test dark mode, mobile view, reduced motion, text size, locale, time zone, geolocation and user agent on any page from one panel.",
  "homepage_url": "https://knobs.dev",
  "minimum_chrome_version": "128",
  "permissions": [
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "knobs",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [{ "resources": ["bezels/*"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" }
}
